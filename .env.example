# Número de teléfono con código de país, sin + ni espacios
# Ejemplo Argentina: 5491123456789
PHONE_NUMBER=

# Carpeta donde se guarda la sesión
SESSION_DIR=./auth

# Prefijo de comandos
PREFIX=!

# Reconexión
MAX_RETRIES=10
RECONNECT_DELAY=2000
MAX_RECONNECT_DELAY=60000

# Carpeta de plugins
PLUGINS_DIR=./plugins
